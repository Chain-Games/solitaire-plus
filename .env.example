# Copy to .env — .env is gitignored and must never be committed.

# --- server ---
PORT=3030
PUBLIC_URL=http://localhost:5373
DATABASE_URL=postgres://solitaire:solitaire@localhost:5459/solitaire
REDIS_URL=redis://localhost:6399
SESSION_SECRET=change-me-to-a-random-64-char-string-change-me-to-a-random-64-c
POSTGRES_PASSWORD=solitaire

# Mock economy (alpha, off-chain)
STARTING_BALANCE=1000
RAKE_BPS=0
DAILY_GRANT=100
DAILY_GRANT_INTERVAL_MS=86400000

# --- admin dashboard (/admin.html) ---
# Unset = the admin API is OFF (503), never open. Set a long random string to
# unlock GET /api/admin/overview with `Authorization: Bearer <token>`.
ADMIN_TOKEN=
# Optional IP geolocation for the dashboard's "where they play", with {ip} as
# the placeholder. Empty = no lookup, no address ever leaves the server.
# GEOIP_URL=http://ip-api.com/json/{ip}?fields=countryCode,regionName
GEOIP_URL=

# --- share cards (/s/:id) ---
# Where the PNGs a player chose to share are kept, relative to apps/server.
# Empty = ./share-cards (gitignored); compose.prod mounts a volume there.
SHARE_DIR=

# --- Web Push (docs/architecture.md § Notifications) ---
# All three empty = push is OFF (never crashes; in-app toasts and the inbox
# still work). Generate a key pair ONCE and keep the private key a secret:
#   pnpm --filter @solitaire/server push:keys      (= npx web-push generate-vapid-keys)
# VAPID_SUBJECT is the contact push services may use about your sender: mailto:.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- deploy ---
DOMAIN=solitaire.example.com
ACME_EMAIL=you@example.com


