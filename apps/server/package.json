{
  "name": "@solitaire-plus/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "push:keys": "web-push generate-vapid-keys"
  },
  "dependencies": {
    "@solitaire-plus/sim": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/session": "^11.1.2",
    "@fastify/static": "8",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "0.38.4",
    "fastify": "5.12.1",
    "ioredis": "5.11.1",
    "postgres": "3.4.9",
    "web-push": "3.6.7",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "0.30.6",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
